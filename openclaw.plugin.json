{
  "id": "imap-smtp",
  "name": "IMAP SMTP",
  "description": "Reads mail through IMAP and sends mail through SMTP.",
  "contracts": {
    "tools": [
      "imap_get_status",
      "imap_list_messages",
      "imap_search_messages",
      "imap_get_message",
      "imap_get_messages",
      "imap_get_attachment_text",
      "imap_get_attachment_image",
      "imap_save_attachment_to_openclaw",
      "imap_save_draft",
      "smtp_send",
      "imap_set_flags",
      "imap_move_messages",
      "imap_delete_messages"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "prereadPlainBytes": {
        "type": "integer",
        "minimum": 1,
        "default": 1024,
        "description": "Default number of bytes read from the start of a text/plain part to make previewText. The tools' prereadPlainBytes parameter overrides it."
      },
      "prereadHtmlBytes": {
        "type": "integer",
        "minimum": 1,
        "default": 2048,
        "description": "Default number of bytes read from the start of a text/html part to make previewText of a message without a text/plain part. The tools' prereadHtmlBytes parameter overrides it."
      },
      "accounts": {
        "type": "object",
        "description": "Mail accounts keyed by accountMailAddress, the email address of the mailbox.",
        "propertyNames": {
          "pattern": "^[^:@\\s]+@[^:@\\s]+$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["imap", "smtp", "identities"],
          "properties": {
            "imap": { "$ref": "#/$defs/server" },
            "smtp": { "$ref": "#/$defs/server" },
            "identities": {
              "type": "array",
              "minItems": 1,
              "description": "Sender addresses that drafts and sent messages may use.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["address"],
                "properties": {
                  "address": { "type": "string" },
                  "name": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "$defs": {
      "server": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "port", "security", "user", "password"],
        "properties": {
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "security": {
            "type": "string",
            "enum": ["ssl", "starttls"],
            "description": "ssl connects with TLS; starttls upgrades the connection with STARTTLS and fails when the server does not offer it. Unencrypted connections are not supported."
          },
          "user": { "type": "string" },
          "password": { "type": "string" }
        }
      }
    }
  }
}
